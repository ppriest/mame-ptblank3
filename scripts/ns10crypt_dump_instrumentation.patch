+// TEMP instrumentation: dump decrypt stream when NS10_DUMP names a file
+static FILE *ns10_dump_file()
+{
+	static FILE *f = nullptr;
+	static bool tried = false;
+	if (!tried) { tried = true; const char *n = std::getenv("NS10_DUMP"); if (n) f = std::fopen(n, "wb"); }
+	return f;
+}
+static void ns10_dump(char type, uint8_t b, uint16_t c, uint16_t p, uint32_t cnt)
+{
+	FILE *f = ns10_dump_file(); if (!f) return;
+	uint8_t r[10] = { uint8_t(type), b, uint8_t(c), uint8_t(c >> 8), uint8_t(p), uint8_t(p >> 8), uint8_t(cnt), uint8_t(cnt >> 8), uint8_t(cnt >> 16), uint8_t(cnt >> 24) };
+	std::fwrite(r, 1, 10, f); std::fflush(f);
+}
 
 
